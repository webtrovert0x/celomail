# Reown AppKit Project ID (from https://dashboard.reown.com)
NEXT_PUBLIC_PROJECT_ID=your_reown_project_id

# IPFS Pinata Keys (for encrypted payloads and attachments)
NEXT_PUBLIC_PINATA_JWT=your_pinata_jwt

# MongoDB (for encrypted contacts, auto-save drafts, and archive)
MONGODB_URI=your_mongodb_connection_string

# AI Engine (Optional: Gemini / OpenAI API key for AI Smart Compose, threat scan & summaries)
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key

# BotChain Testnet Contract Address (Optional override)
# NEXT_PUBLIC_CONTRACT_ADDRESS=0x...
# NEXT_PUBLIC_DEPLOYMENT_BLOCK=0

# Nodemailer SMTP settings (for Web2 email notification bridge)
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_16_character_app_password
